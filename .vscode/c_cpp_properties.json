{
    "configurations": [
        {
            "name": "STM32F103 (POWER_QUALITY)",
            "includePath": [
                "${workspaceFolder}/firmware/POWER_QUALITY/Core/Inc",
                "${workspaceFolder}/firmware/POWER_QUALITY/Drivers/CMSIS/Core",
                "${workspaceFolder}/firmware/POWER_QUALITY/Drivers/CMSIS/Device",
                "${workspaceFolder}/firmware/POWER_QUALITY/Drivers/STM32F10x_StdPeriph_Driver/inc",
                "${workspaceFolder}/firmware/POWER_QUALITY/Middlewares/Third_Party/FreeRTOS/Source/include",
                "${workspaceFolder}/firmware/POWER_QUALITY/Middlewares/Third_Party/FreeRTOS/Source/portable/GCC/ARM_CM3",
                "${workspaceFolder}/firmware/POWER_QUALITY/Hardware/**",
                "${workspaceFolder}/firmware/POWER_QUALITY/middle/**",
                "${workspaceFolder}/firmware/POWER_QUALITY/third_party/**",
                "/usr/lib/gcc/arm-none-eabi/10.3.1/include",
                "/usr/include/newlib"
            ],
            "defines": [
                "STM32F10X_MD",
                "USE_STDPERIPH_DRIVER"
            ],
            "compilerPath": "/usr/bin/arm-none-eabi-gcc",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-arm",
            "compileCommands": "${workspaceFolder}/firmware/POWER_QUALITY/compile_commands.json",
            "browse": {
                "path": [
                    "${workspaceFolder}/firmware/POWER_QUALITY/Core/Inc",
                    "${workspaceFolder}/firmware/POWER_QUALITY/Drivers/CMSIS/Core",
                    "${workspaceFolder}/firmware/POWER_QUALITY/Drivers/CMSIS/Device",
                    "${workspaceFolder}/firmware/POWER_QUALITY/Drivers/STM32F10x_StdPeriph_Driver/inc",
                    "${workspaceFolder}/firmware/POWER_QUALITY/Middlewares/Third_Party/FreeRTOS/Source/include",
                    "${workspaceFolder}/firmware/POWER_QUALITY/Middlewares/Third_Party/FreeRTOS/Source/portable/GCC/ARM_CM3",
                    "${workspaceFolder}/firmware/POWER_QUALITY/Hardware",
                    "${workspaceFolder}/firmware/POWER_QUALITY/middle",
                    "${workspaceFolder}/firmware/POWER_QUALITY/third_party"
                ],
                "limitSymbolsToIncludedHeaders": false
            }
        },
        {
            "name": "ESP32-S3 (GATE)",
            "compileCommands": "${workspaceFolder}/firmware/GATE/build/compile_commands.json",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-arm"
        }
    ],
    "version": 4
}
